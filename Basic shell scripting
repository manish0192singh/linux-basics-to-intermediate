18. Practical Example: System Information Script
------------------------------------------------
#!/bin/bash                                     |
                                                |
echo "===== System Information ====="           |  
                                                |
echo "User: $(whoami)"                          |
echo "Hostname: $(hostname)"                    |
echo "Kernel: $(uname -r)"                      |
                                                |
echo                                            |
echo "===== CPU ====="                          |
lscpu | grep "Model name"                       |
                                                |
echo                                            |
echo "===== Memory ====="                       |
free -h                                         |
                                                |
echo                                            |
echo "===== Disk ====="                         |
df -h                                           |
------------------------------------------------|

Run:
chmod +x system_info.sh
./system_info.sh

